rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/customers/$(request.auth.uid)) &&
        (currentUser().data.get('role', '') in ['admin', 'yonetici', 'yönetici'] ||
         currentUser().data.get('isAdmin', false) == true ||
         currentUser().data.get('admin', false) == true);
    }

    function ownsRestaurant(restaurantId) {
      return signedIn() && request.auth.uid == restaurantId;
    }

    function tableServiceEnabled(restaurantId) {
      return get(/databases/$(database)/documents/customers/$(restaurantId))
          .data.tableServiceEnabled == true;
    }

    function safeSelfRole(data) {
      return !('role' in data) ||
        data.role in [
          'customer',
          'vendor_pending',
          'seller_pending',
          'satici_pending',
          'emlakci_pending',
          'kurumsal_satici_pending'
        ];
    }

    function safeSelfCustomerCreate(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        safeSelfRole(request.resource.data) &&
        request.resource.data.get('isAdmin', false) != true &&
        request.resource.data.get('admin', false) != true &&
        request.resource.data.get('isApproved', false) != true &&
        request.resource.data.get('sellerApproved', false) != true &&
        request.resource.data.get('corporateSellerApproved', false) != true &&
        request.resource.data.get('tableServiceEnabled', false) != true;
    }

    function sensitiveCustomerFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role',
        'isAdmin',
        'admin',
        'isApproved',
        'sellerApproved',
        'corporateSellerApproved',
        'sellerStatus',
        'corporateSellerStatus',
        'allowedCorporateCategories',
        'tableServiceEnabled',
        'tableServiceUpdatedAt'
      ]);
    }

    function safeSelfCustomerUpdate(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        sensitiveCustomerFieldsUnchanged();
    }

    function safeSelfPendingApplicationUpdate(userId) {
      return signedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role in [
          'vendor_pending',
          'seller_pending',
          'satici_pending',
          'emlakci_pending',
          'kurumsal_satici_pending'
        ] &&
        request.resource.data.get('isApproved', false) != true &&
        request.resource.data.get('isAdmin', false) != true &&
        request.resource.data.get('admin', false) != true &&
        request.resource.data.get('sellerApproved', false) != true &&
        request.resource.data.get('corporateSellerApproved', false) != true &&
        request.resource.data.get('tableServiceEnabled', false) != true;
    }

    function validTable(data) {
      return data.name is string &&
        data.name.size() > 0 && data.name.size() <= 50 &&
        data.status in ['empty', 'occupied', 'reserved', 'bill_requested'];
    }

    function validOrder(data, restaurantId) {
      return data.vendorId == restaurantId &&
        data.tableId is string && data.tableName is string &&
        data.status in ['active', 'closed'] &&
        data.items is list && data.items.size() <= 200 &&
        data.payments is list && data.payments.size() <= 100 &&
        data.grandTotal is number && data.paidTotal is number;
    }

    // ── customers ─────────────────────────────────────────────────────────────
    // FIX: Kamuya açık okuma kaldırıldı (KVKK). Kendi verisini veya admin okur.
    match /customers/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || safeSelfCustomerCreate(userId);
      allow update: if isAdmin() ||
                      safeSelfCustomerUpdate(userId) ||
                      safeSelfPendingApplicationUpdate(userId);
      allow delete: if isAdmin() ||
                       (signedIn() && request.auth.uid == userId);

      // FIX: extras alt koleksiyonuna sadece kendi kullanıcısı yazabilir
      match /extras/{extraId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }

      match /saved_posts/{postId} {
        allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
      }

      match /restaurant_tables/{tableId} {
        allow read: if (ownsRestaurant(userId) && tableServiceEnabled(userId)) ||
                       isAdmin();
        allow create, update: if ownsRestaurant(userId) &&
                                tableServiceEnabled(userId) &&
                                validTable(request.resource.data);
        allow delete: if ownsRestaurant(userId) &&
                         tableServiceEnabled(userId) &&
                         resource.data.activeOrderId == null;
      }

      match /table_orders/{orderId} {
        allow read: if (ownsRestaurant(userId) && tableServiceEnabled(userId)) ||
                       isAdmin();
        allow create, update: if ownsRestaurant(userId) &&
                                tableServiceEnabled(userId) &&
                                validOrder(request.resource.data, userId);
        allow delete: if false;
      }
    }

    match /orders/{document=**} {
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn() && (
        request.resource.data.customerId == request.auth.uid ||
        request.resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow update: if signedIn() && (
        resource.data.sellerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /businesses/{document=**} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.editorId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    match /admin_activity_log/{document=**} { allow read, write: if isAdmin(); }
    match /admin_notification_requests/{document=**} {
      allow read: if isAdmin();
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /admin_notifications_log/{document=**} { allow read, write: if isAdmin(); }
    match /admin_tokens/{document=**} { allow read, write: if isAdmin(); }
    match /announcements/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_notifications/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /app_settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /business_claims/{document=**} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /campaigns/{document=**} {
      allow read: if true;
      allow create: if signedIn() && (
        isAdmin() ||
        request.resource.data.sellerId == request.auth.uid ||
        request.resource.data.vendorId == request.auth.uid
      );
      allow update, delete: if signedIn() && (
        isAdmin() ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid
      );
    }
    match /cateogries/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /muhtarliklar/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cek_gonder_reports/{docId} {
      // FIX: Sadece kendi raporunu okuyabilir
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
    }
    match /classified_ads/{adId} {
      allow read: if true;
      // FIX: create'de sahiplik ID kontrolü eklendi
      allow create: if signedIn() && (
        request.resource.data.get('userId', request.auth.uid) == request.auth.uid ||
        request.resource.data.get('ownerId', request.auth.uid) == request.auth.uid ||
        isAdmin()
      );
      allow update, delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // FIX: comments — sahiplik kontrolü eklendi, başkasının yorumu silinemez
    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('authorId', '') == request.auth.uid ||
        isAdmin()
      );
    }
    // Alt koleksiyon yorumları için de aynı kural
    match /{path=**}/comments/{commentId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        resource.data.get('authorId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    match /complaints/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /corporate_seller_applications/{document=**} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /custom_pages/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /customer_order_push_requests/{document=**} {
      // FIX: Sadece kendi siparişini okuyabilir
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid || isAdmin()
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /dernekler/{document=**} {
      allow read: if true;
      allow create: if signedIn();
      // FIX: e-posta tabanlı yetkide email_verified kontrolü eklendi
      allow update, delete: if isAdmin() || (signedIn() && (
        resource.data.applicantId == request.auth.uid ||
        (resource.data.adminEmail == request.auth.token.email &&
         request.auth.token.email_verified == true)
      ));
    }
    match /earthquake_alerts/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FIX: group_posts — sahiplik kontrolü eklendi
    match /group_posts/{postId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.get('authorId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // FIX: group_reports — sadece kendi raporunu okur
    match /group_reports/{reportId} {
      allow read: if signedIn() && (
        resource.data.get('reporterId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /job_ads/{adId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    match /job_postings/{adId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
    match /notification_send_requests/{document=**} { allow read, write: if isAdmin(); }
    match /notifications/{document=**} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.to == request.auth.uid || isAdmin());
    }

    // FIX: phone_verification_requests — sadece kendi kaydını okur/yazar
    match /phone_verification_requests/{docId} {
      allow read, write: if signedIn() && (
        resource.data.get('uid', '') == request.auth.uid || isAdmin()
      );
      allow create: if signedIn() &&
        request.resource.data.get('uid', '') == request.auth.uid;
    }

    match /polls/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FIX: posts — sahiplik kontrolü eklendi
    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.get('authorId', '') == request.auth.uid ||
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    match /products/{document=**} {
      allow read: if true;
      allow create: if signedIn() && (
        isAdmin() ||
        request.resource.data.vendorId == request.auth.uid ||
        request.resource.data.sellerId == request.auth.uid
      );
      allow update, delete: if signedIn() && (
        isAdmin() ||
        resource.data.vendorId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
    }

    // FIX: reads — sadece kendi kayıtlarını yönetir
    match /reads/{docId} {
      allow read, write: if signedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        docId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn();
    }

    match /requests_complaints/{document=**} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.uid == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /reviews/{document=**} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // FIX: seller_order_push_requests — sadece kendi satıcı ID'si
    match /seller_order_push_requests/{docId} {
      allow read: if signedIn() && (
        resource.data.sellerId == request.auth.uid || isAdmin()
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /seller_reviews/{document=**} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        resource.data.reviewerId == request.auth.uid ||
        isAdmin()
      );
    }

    // FIX: sellers — create sadece kendi sellerId ile
    match /sellers/{sellerId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == sellerId;
      allow update, delete: if signedIn() && (
        request.auth.uid == sellerId ||
        isAdmin()
      );
    }

    match /sikayetler/{docId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }
    match /story_categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FIX: user_notification_requests — sadece hedef uid veya admin okur
    match /user_notification_requests/{docId} {
      allow read: if signedIn() && (
        resource.data.get('targetUid', '') == request.auth.uid || isAdmin()
      );
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // FIX: votes — sahiplik kontrolü, oy manipülasyonu engellendi
    match /votes/{voteId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid;
      allow update, delete: if signedIn() && (
        resource.data.get('userId', '') == request.auth.uid || isAdmin()
      );
    }
  }
}
